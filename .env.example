PORT=4000
JWT_SECRET=change-me-in-production
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/snap_app?retryWrites=true&w=majority
ADMIN_EMAIL=admin@snapapp.com
ADMIN_PASSWORD=Admin@123
FIREBASE_STORAGE_BUCKET=snap-app-8c28d.firebasestorage.app
# Public origin for shared pose links (WhatsApp / Copy Link).
PUBLIC_SHARE_BASE_URL=https://snap-app-m7koi.ondigitalocean.app
# Optional: paste full service-account JSON as a single line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Optional WebRTC TURN (DigitalOcean Droplet running docker-compose.turn.yml)
# TURN_HOST=your.droplet.ip
# TURN_USER=snap
# TURN_PASS=snapturn

# Gmail SMTP for OTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
