{
  "name": "snap-app-backend",
  "version": "1.0.0",
  "description": "Snap App API — user & admin endpoints (MongoDB / Mongoose)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/data/seed.js",
    "seed:force": "node src/data/seed.js --force",
    "mongo:up": "docker start snap-mongo || docker run -d --name snap-mongo -p 27017:27017 -e MONGO_INITDB_DATABASE=snap_app mongo:7"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "nanoid": "^3.3.8",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.5"
  }
}
